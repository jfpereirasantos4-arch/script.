local function Tentar()
	if bloqueado then return end

	if KILL then
		Diz("Acesso fechado: kill switch ativo no canal.", Color3.fromRGB(255, 120, 120))
		return
	end

	local k = string.upper((Input.Text or ""):gsub("%s", ""))
	Input.Text = k

	if #k < 8 or #k > 40 or not k:match("^[%w%-]+$") then
		Diz("Key invalida. Confira o formato VNC-XXXX-XXXX.", Color3.fromRGB(255, 150, 110))
		return
	end

	if os.time() - ultimaSinc > CONFIG.TTL then
		Diz("Sincronizando com o Discord...", CONFIG.ACENTO)
		Sincronizar()
	end

	if erroSync then
		if next(KEYS) == nil then
			local dica = (erroSync == "bloqueio de rede") and "Rede bloqueada. Tente outro executor." or erroSync
			Diz("Servidor de keys: " .. dica, Color3.fromRGB(255, 170, 90))
			return
		end
		Diz("Modo offline. Usando cache.", Color3.fromRGB(255, 170, 90))
	end

	if next(KEYS) == nil then
		Diz("Nenhuma key publicada no canal.", Color3.fromRGB(255, 170, 90))
		return
	end

	if not KEYS[k] then
		tentativas = tentativas + 1
		Diz("Key inexistente. Tentativa " .. tentativas .. "/5.", Color3.fromRGB(255, 120, 120))
		Log("KEY INVALIDA", "`" .. k .. "`", 15158332,
			Campos({ { name = "Tentativa", value = tostring(tentativas), inline = true } }))
		if tentativas >= 5 then
			bloqueado = true
			for i = 12, 1, -1 do
				Diz("Muitas tentativas. Aguarde " .. i .. "s.", Color3.fromRGB(255, 170, 90))
				task.wait(1)
			end
			tentativas, bloqueado = 0, false
			Diz("Pode tentar de novo.", Color3.fromRGB(140, 143, 158))
		end
		return
	end

	if REV[k] then
		Diz("Esta key foi revogada.", Color3.fromRGB(255, 120, 120))
		Log("KEY REVOGADA", "`" .. k .. "`", 15158332, Campos(), true)
		return
	end

	local dono = LOCKS[k]
	if CONFIG.FIXO and dono and dono:sub(1, 16) ~= HWID_CURTO then
		Diz("Key presa em outro dispositivo.", Color3.fromRGB(255, 170, 90))
		Log("KEY EM USO", "`" .. k .. "` presa em `" .. dono .. "`", 15105570, Campos(), true)
		return
	end

	Diz("Validando...", CONFIG.ACENTO)
	Botao.Text = "..."
	Salvar(k)
	Log("KEY ATIVADA", "`" .. k .. "`", 5763719, Campos({ { name = "Key", value = k, inline = false } }), true)
	task.wait(.35)
	Botao.Text = "ATIVAR"
	Fechar()
end

Botao.MouseButton1Click:Connect(Tentar)
Input.Focused:Connect(function() CxStroke.Color = CONFIG.ACENTO end)
Input.FocusLost:Connect(function(enter)
	CxStroke.Color = Color3.fromRGB(60, 62, 80)
	if enter then Tentar() end
end)

