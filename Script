local KEYS, REV, LOCKS = {}, {}, {}
local KILL, sincronizando, ultimaSinc, erroSync = false, false, 0, nil

local function Aplicar(texto)
	local t = string.upper(texto)
	if t:match("^%s*KILL%s*$") then KILL = true return end
	local cmd, arg, extra = t:match("^%s*(%a+)%s+(%S+)%s*(%S*)")
	if not cmd then return end
	if cmd == "KEY" then
		KEYS[arg] = true REV[arg] = nil
	elseif cmd == "REV" then
		REV[arg] = true
	elseif cmd == "LIB" then
		LOCKS[arg] = nil
	elseif cmd == "LOCK" and extra ~= "" then
		LOCKS[arg] = string.lower(extra)
	end
end

local function SalvarCache()
	if not writefile then return end
	pcall(writefile, CACHE, HS:JSONEncode({ keys = KEYS, rev = REV, locks = LOCKS, kill = KILL }))
end

local function LerCache()
	local ok, txt = pcall(function() return isfile(CACHE) and readfile(CACHE) end)
	if not ok or not txt then return false end
	local ok2, d = pcall(function() return HS:JSONDecode(txt) end)
	if not ok2 or type(d) ~= "table" then return false end
	KEYS, REV, LOCKS, KILL = d.keys or {}, d.rev or {}, d.locks or {}, d.kill == true
	return true
end

local function Sincronizar()
	if sincronizando then return end
	sincronizando = true
	local r = Req()
	if not r then sincronizando = false erroSync = "sem request" return end

	local novas, antes, okPagina = {}, nil, false
	for _ = 1, 3 do
		local url = API .. "/channels/" .. CONFIG.CANAL .. "/messages?limit=100" .. (antes and ("&before=" .. antes) or "")
		local res, tentou = nil, 0
		repeat
			tentou = tentou + 1
			local ok, r2 = pcall(r, { Url = url, Method = "GET", Headers = {
				["Authorization"] = "Bot " .. CONFIG.TOKEN,
				["User-Agent"] = CONFIG.UA,
				["Accept"] = "*/*" } })
			if ok then res = r2 end
			if res and res.StatusCode == 429 then
				local ok3, d = pcall(function() return HS:JSONDecode(res.Body) end)
				task.wait((ok3 and d and tonumber(d.retry_after)) or 1.5)
				res = nil
			end
		until res or tentou >= 2

		if not res or not res.Body then erroSync = "offline" break end
		if res.StatusCode == 401 then erroSync = "token invalido" break end
		if res.StatusCode == 403 then
			local ok3, d = pcall(function() return HS:JSONDecode(res.Body) end)
			local code = (ok3 and d and d.code) or 0
			erroSync = (code == 40333) and "bloqueio de rede" or "sem permissao no canal"
			break
		end
		if res.StatusCode == 404 then erroSync = "canal invalido" break end
		if res.StatusCode ~= 200 then erroSync = "HTTP " .. tostring(res.StatusCode) break end

		okPagina = true
		local ok2, lista = pcall(function() return HS:JSONDecode(res.Body) end)
		if not ok2 or type(lista) ~= "table" or #lista == 0 then break end
		for _, m in ipairs(lista) do
			if m.content then novas[#novas + 1] = m.content end
		end
		antes = lista[#lista].id
		if #lista < 100 then break end
	end

	if okPagina then
		local limpo = {}
		for i = #novas, 1, -1 do limpo[#limpo + 1] = novas[i] end
		KEYS, REV, LOCKS, KILL = {}, {}, {}, false
		for _, txt in ipairs(limpo) do Aplicar(txt) end
		SalvarCache()
		erroSync = nil
	end
	ultimaSinc = os.time()
	sincronizando = false
end

