					Font=Enum.Font.GothamBold,TextSize=15,BorderSizePixel=0,Parent=r})
				N("UICorner",{CornerRadius=UDim.new(0,6)},pl)
				mi.MouseButton1Click:Connect(function() sv(c-(st or 1)) end)
				pl.MouseButton1Click:Connect(function() sv(c+(st or 1)) end)
				v.Text=tostring(c)
			end
			t.Drop=function(txt,vals,def,cb)
				local r,_,v=Linha(txt)
				local i=1
				for j,x in ipairs(vals) do if x==def then i=j end end
				local function rf() v.Text=tostring(vals[i]) end
				r.MouseButton1Click:Connect(function()
