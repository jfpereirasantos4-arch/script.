	function Teleport(cf,hold)
		local _,_,h=Char() if not h then return end
		pcall(function() h:SetNetworkOwner(LP) end)
		if Cfg.Mov.Seguro then h.Anchored=true end
		h.CFrame=cf TP.CF=cf TP.Ate=tick()+(hold or .7) TP.Anc=Cfg.Mov.Seguro
