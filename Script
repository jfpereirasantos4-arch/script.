			t.Tog=function(txt,def,cb)
				local r,_,v=Linha(txt)
				local s=def and true or false
				local function rf()
					v.Text=s and "ON" or "OFF"
					v.TextColor3=s and Color3.fromRGB(90,230,140) or Color3.fromRGB(150,150,160)
					r.BackgroundColor3=s and Color3.fromRGB(34,48,40) or Color3.fromRGB(31,32,41)
				end
				r.MouseButton1Click:Connect(function() s=not s rf() task.spawn(function() pcall(cb,s) end) end)
				rf()
			end
