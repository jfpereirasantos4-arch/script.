			local function NF(c,pr)
				local f=N(c,pr,EG) f.BorderSizePixel=0 f.Visible=false return f
			end
			local function Criar(p)
				if p==LP or ESPObj[p] then return end
				local d={L={}}
				for i=1,#R15 do d.L[i]=NF("Frame",{AnchorPoint=Vector2.new(.5,.5),
					BackgroundColor3=Cfg.ESP.Cor,Size=UDim2.fromOffset(1,1),ZIndex=2}) end
				d.B=NF("Frame",{BackgroundTransparency=.85,BackgroundColor3=Cfg.ESP.Cor,ZIndex=1})
