				d.N=NF("TextLabel",{Size=UDim2.fromOffset(220,18),BackgroundTransparency=1,TextColor3=Color3.new(1,1,1),
					TextStrokeTransparency=.25,Font=Enum.Font.GothamBold,TextSize=13,ZIndex=3})
				d.I=NF("TextLabel",{Size=UDim2.fromOffset(220,16),BackgroundTransparency=1,
					TextColor3=Color3.fromRGB(215,215,215),TextStrokeTransparency=.35,Font=Enum.Font.Gotham,TextSize=11,ZIndex=3})
				d.H=NF("Frame",{AnchorPoint=Vector2.new(1,1),BackgroundColor3=Color3.fromRGB(0,255,80),ZIndex=3})
				d.T=NF("Frame",{AnchorPoint=Vector2.new(0,.5),BackgroundColor3=Cfg.ESP.Cor,ZIndex=1})
				ESPObj[p]=d
			end
			local function Ocultar(d)
				for _,l in ipairs(d.L) do l.Visible=false end
				d.B.Visible=false d.N.Visible=false d.I.Visible=false d.H.Visible=false d.T.Visible=false
			end
			DelESP=function(p)
				local d=ESPObj[p] if not d then return end
				for _,l in ipairs(d.L) do pcall(function() l:Destroy() end) end
				for _,o in ipairs({d.B,d.N,d.I,d.H,d.T}) do pcall(function() o:Destroy() end) end
				ESPObj[p]=nil
			end
			UpESP=function()
				if not Cfg.ESP.On then for _,d in pairs(ESPObj) do Ocultar(d) end return end
				for p,d in pairs(ESPObj) do
