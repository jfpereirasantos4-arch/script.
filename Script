task.spawn(function()
	Diz("Conectando ao canal de keys...", CONFIG.ACENTO)
	local tinhaCache = LerCache()
	Sincronizar()

	if next(KEYS) == nil and tinhaCache then
		Diz("Canal indisponivel. Cache local carregado.", Color3.fromRGB(255, 170, 90))
	elseif next(KEYS) == nil then
		Diz(erroSync and ("Falha: " .. erroSync) or "Nenhuma key publicada no canal.", Color3.fromRGB(255, 120, 120))
	else
		local q = 0 for _ in pairs(KEYS) do q = q + 1 end
		Diz("Pronto. " .. q .. " keys carregadas.", Color3.fromRGB(140, 143, 158))
	end

	if KILL then Diz("KILL ativo no canal. Acesso fechado.", Color3.fromRGB(255, 120, 120)) return end

	local salva = Ler()
	if salva and KEYS[string.upper(salva)] and not REV[string.upper(salva)] then
		Input.Text = string.upper(salva)
		Diz("Key salva detectada. Revalidando...", CONFIG.ACENTO)
		task.wait(.6)
		Tentar()
	end
end)

